# Copy to backend/.env and fill in. Never commit the real .env.

# ── LLM (optional — leave LLM_API_KEY empty to run without AI) ──
LLM_PROVIDER=gemini            # gemini | openai | azure_openai | anthropic
LLM_API_KEY=
LLM_MODEL=                     # blank = provider default
LLM_BASE_URL=                  # Azure OpenAI deployment URL or internal gateway; blank for public APIs

# ── Unity (optional — leave blank to use the sample catalog) ──
UNITY_PORTAL_BASE=             # base URL of your Unity portal, used for "Request" links
UNITY_API_BASE=
UNITY_API_TOKEN=

# ── Display ──
APP_USER_NAME=Guest            # shown in the header and greeting
